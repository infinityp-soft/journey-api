[Unit]
Description=Journey Education Admin CMS API
After=network.target postgresql.service rustfs.service
Wants=postgresql.service rustfs.service

[Service]
Type=simple
User=journey
Group=journey
WorkingDirectory=/opt/journey
EnvironmentFile=/etc/journey/api.env
ExecStartPre=/usr/bin/npx prisma migrate deploy
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
