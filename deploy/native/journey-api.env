NODE_ENV=production
PORT=3000
API_PREFIX=api

DATABASE_URL=postgresql://journey:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/journey?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

MEDIA_DRIVER=rustfs
PUBLIC_MEDIA_URL=https://api.example.com/media
MAX_UPLOAD_MB=5

RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=journey-media
RUSTFS_ACCESS_KEY=journey
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET
RUSTFS_FORCE_PATH_STYLE=true

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_ADMIN_NAME=Super Administrator
