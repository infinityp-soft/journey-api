# คัดลอกเป็น .env แล้วกรอกค่าให้ครบก่อน docker compose up
# สร้าง secret: openssl rand -hex 32

# พอร์ตที่เปิดออกเครื่อง (map ไป web:3002) — เข้าเว็บที่ http://<IP>:<HTTP_PORT>
# ใช้ 8080 เพราะพอร์ต 80 มีบริการอื่นถืออยู่ ถ้าเครื่องว่างจะตั้งเป็น 80 ก็ได้
HTTP_PORT=8080

# ถ้ามี reverse proxy ซ้อนอีกชั้น ค่อยใส่ host:port ที่เปิดในเบราว์เซอร์
# ตัวอย่าง: 139.177.187.238:8080
SERVER_ACTION_ORIGINS=

POSTGRES_DB=journey
POSTGRES_USER=journey
POSTGRES_PASSWORD=CHANGE_ME_LONG_DB_PASSWORD

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

RUSTFS_ACCESS_KEY=journey
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET
RUSTFS_BUCKET=journey-media

MAX_UPLOAD_MB=5
JSON_BODY_LIMIT_MB=10

# บัญชี admin ที่ sh seed.sh จะสร้างให้ — ตั้งรหัสจริงตั้งแต่แรกจะปลอดภัยกว่า
SEED_ADMIN_EMAIL=admin@journeyth-edu.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_ADMIN_NAME=Super Administrator

# ปล่อยว่างได้ถ้ายังไม่ได้เปิดใช้ x-api-key ฝั่ง API
NEXT_PUBLIC_API_KEY=
