# บนเซิร์ฟเวอร์: .env + docker-compose.yml + โฟลเดอร์ nginx/
# ไม่ต้อง clone ซอร์ส Nest

API_IMAGE=ghcr.io/CHANGE_ME/journey-api:latest
# มี FE แล้วค่อยใส่ แล้วเปิด profile frontend
WEB_IMAGE=ghcr.io/CHANGE_ME/journey-web:latest

# โดเมนที่ชี้มาที่เซิร์ฟเวอร์ (Nginx ฟัง 80/443)
DOMAIN=api.example.com
PUBLIC_ORIGIN=https://api.example.com

POSTGRES_DB=journey
POSTGRES_USER=journey
POSTGRES_PASSWORD=CHANGE_ME_LONG_DB_PASSWORD

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

RUSTFS_ACCESS_KEY=journey
RUSTFS_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET
RUSTFS_BUCKET=journey-media
