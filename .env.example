# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
JSON_BODY_LIMIT_MB=10             # JSON/urlencoded body size (HTML content)

# --- Database (PostgreSQL / Prisma) ---
DATABASE_URL=postgresql://journey:secret@localhost:5432/journey?schema=public
DB_LOGGING=false

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# --- Media storage ---
MEDIA_DRIVER=local                    # local | rustfs
PUBLIC_MEDIA_URL=http://localhost:3000/media
MAX_UPLOAD_MB=5

# MEDIA_DRIVER=local — files on a mounted volume
UPLOAD_DIR=./storage/uploads          # in prod: /data/uploads (a persistent volume)

# MEDIA_DRIVER=rustfs — S3-compatible object storage (the bucket is auto-created)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=journey-media
RUSTFS_ACCESS_KEY=journey
RUSTFS_SECRET_KEY=change-me-rustfs-secret
RUSTFS_FORCE_PATH_STYLE=true          # false only when RUSTFS_SERVER_DOMAINS is set

# --- Bootstrap admin (created by seed) ---
SEED_ADMIN_EMAIL=admin@journeyth-edu.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Administrator
